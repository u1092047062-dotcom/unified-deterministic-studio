# Einheitliche lokale Konfiguration fuer Unified Deterministic Studio
# Kopiere diese Datei lokal nach .env und trage eigene Werte ein.
# Niemals echte Secrets oder .env-Dateien committen!

# --- EDA Multi-Agent Core (FastAPI bindet standardmaessig nur lokal) ---
EDA_SERVER_HOST=127.0.0.1
EDA_SERVER_PORT=8000
EDA_LOG_DIR=./apps/eda-multiagent-core/logs
EDA_LOG_LEVEL=INFO
EDA_JOBS_DIR=./apps/eda-multiagent-core/logs/jobs

# --- ART Restoration AI (Quality-First Media Pipeline, nur lokal gebunden) ---
ART_SERVER_HOST=127.0.0.1
ART_SERVER_PORT=8010
ART_LOG_DIR=./apps/art-restoration-ai/logs
ART_LOG_LEVEL=INFO
ART_DATA_DIR=./apps/art-restoration-ai/data
ART_WORK_DIR=./apps/art-restoration-ai/work
ART_MAX_UPLOAD_MB=100
ART_MAX_LOCAL_ENGINE_PIXELS=20000000
RUNPOD_ENABLED=false
RUNPOD_API_KEY=

# --- TerraRemoteEngine Monitoring Sidecar (Fail-Closed Defaults) ---
TELEGRAM_NOTIFY_ENABLED=false
TELOXIDE_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID
ALLOW_REMOTE_SCREEN_CAPTURE=false
ALLOW_REMOTE_PROCESS_TERMINATION=false
EDA_WATCHLIST_PROCESSES=eda-cad-studio.exe,python.exe,uvicorn.exe,cargo.exe,kicad-cli.exe,openscad.exe
PLATFORM_WATCHLIST_PROCESSES=tpai.exe,gigapixel.exe
EDA_PIPELINE_LOG_PATH=D:\MEINE_PROJEKTE\unified-deterministic-studio\apps\eda-multiagent-core\logs\eda_pipeline.log
ART_PIPELINE_LOG_PATH=D:\MEINE_PROJEKTE\unified-deterministic-studio\apps\art-restoration-ai\logs\art_pipeline.log
