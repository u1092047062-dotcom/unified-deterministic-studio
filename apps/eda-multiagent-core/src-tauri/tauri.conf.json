{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "EDA Multi-Agent CAD Studio",
    "version": "1.0.0",
    "identifier": "com.eda-multiagent.cad-studio",
    "build": {
        "frontendDist": "../frontend"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "EDA Multi-Agent CAD Studio",
                "width": 1440,
                "height": 900,
                "minWidth": 1440,
                "minHeight": 900
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/icon.ico"]
    }
}
