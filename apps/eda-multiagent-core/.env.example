# Lokale Konfiguration fuer eda-multiagent-core
# Kopiere diese Datei lokal nach .env und trage eigene Werte ein.
# Niemals echte Secrets oder .env-Dateien in Git committen!

# FastAPI-Server (standardmaessig nur lokal gebunden)
EDA_SERVER_HOST=127.0.0.1
EDA_SERVER_PORT=8000

# Strukturiertes Pipeline-Logging & Telemetrie
EDA_LOG_DIR=./logs
EDA_LOG_LEVEL=INFO
EDA_PIPELINE_LOG_PATH=./logs/eda_pipeline.log

# Optionale Telegram-Benachrichtigungen / TerraRemoteEngine-Sidecar (standardmaessig deaktiviert)
TELEGRAM_NOTIFY_ENABLED=false
TELOXIDE_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALLOWED_USER_ID=YOUR_NUMERIC_TELEGRAM_USER_ID

# Zusaetzliche Prozess-Watchlist fuer TerraRemoteEngine (kommagetrennt)
EDA_WATCHLIST_PROCESSES=eda-cad-studio.exe,python.exe,uvicorn.exe,cargo.exe,kicad-cli.exe,openscad.exe

# Sicherheits-Guardrails (Fail-Closed: standardmaessig deaktiviert)
ALLOW_REMOTE_SCREEN_CAPTURE=false
ALLOW_REMOTE_PROCESS_TERMINATION=false
